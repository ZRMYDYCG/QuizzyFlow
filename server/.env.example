# 服务配置
PORT=3005
NODE_ENV=development

# MongoDB 配置
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=quizzyflow

# JWT 配置
JWT_SECRET=quizzyflow
JWT_EXPIRES_IN=7d

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# LLM 配置（OpenAI 兼容，默认 MiniMax M2.7）
# 国内: https://api.minimaxi.com/v1  海外: https://api.minimax.io/v1
LLM_PROVIDER=minimax
LLM_API_KEY=your-minimax-api-key
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.7

# 硅基流动（备用，LLM_PROVIDER=siliconflow 时生效）
# SILICON_FLOW_API_KEY=
# SILICON_FLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICON_FLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 联网搜索（Agent web_search 工具，二选一即可）
# Tavily: https://tavily.com
TAVILY_API_KEY=
# Serper（Google 搜索）: https://serper.dev
# SERPER_API_KEY=